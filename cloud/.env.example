# Infoflex Cloud — environment variables.
#
# Copy this file to `.env` on the server (it is git-ignored), fill in the values, and never commit the result.
# Anything containing KEY, SECRET or PASSWORD must be empty in this file: a value here would be copied straight
# into production. Each of these may also be supplied as `<NAME>_FILE=/path/to/secret` when the host injects
# docker secrets rather than environment variables.

NODE_ENV=production
PORT=8080

# Where the SQLite database and the automatic backups live. Mount a volume at /data.
INFOFLEX_CLOUD_DATABASE=/data/infoflex-cloud.sqlite
INFOFLEX_CLOUD_BACKUP_DIR=/data/backups
INFOFLEX_CLOUD_BACKUP_KEEP=14

# The address customers' PCs and phones use. Must be https:// in production.
INFOFLEX_CLOUD_PUBLIC_URL=https://licences.example.com

# The Ed25519 signing key. Use INFOFLEX_CLOUD_SIGNING_KEY_FILE so the PEM never appears in `docker inspect`.
#   openssl genpkey -algorithm ed25519 -out cloud-signing-key.pem
INFOFLEX_CLOUD_SIGNING_KEY=
INFOFLEX_CLOUD_SIGNING_KEY_FILE=
INFOFLEX_CLOUD_SIGNING_KEY_ID=infoflex-cloud-1

# 32+ random characters. Generate with: openssl rand -base64 48
INFOFLEX_CLOUD_SESSION_SECRET=
INFOFLEX_CLOUD_SESSION_MINUTES=30

# Optional. Set both only if you are running the internet relay for Admin phones.
INFOFLEX_CLOUD_RELAY_DOMAIN=
INFOFLEX_CLOUD_RELAY_SECRET=

# Only this address may create the first Owner account. Set it before the first visit.
INFOFLEX_CLOUD_OWNER_EMAIL=

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For.
INFOFLEX_CLOUD_TRUST_PROXY=true

# Optional e-mail for expiry reminders. Leave SMTP_HOST blank and reminders appear in the portal only.
INFOFLEX_CLOUD_SMTP_HOST=
INFOFLEX_CLOUD_SMTP_PORT=587
INFOFLEX_CLOUD_SMTP_SECURE=false
INFOFLEX_CLOUD_SMTP_USER=
INFOFLEX_CLOUD_SMTP_PASSWORD=
INFOFLEX_CLOUD_MAIL_FROM=
INFOFLEX_CLOUD_VENDOR_EMAIL=
