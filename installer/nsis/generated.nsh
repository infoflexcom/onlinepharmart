; ==========================================================================================
; ValidateCurrencyCode — used by silent installs to check a /CURRENCY= argument.
;
; Takes the code in $0. On a match, leaves the canonical code in $3 and its index in $2.
; On no match, leaves $3 empty so the caller can abort with a reason.
;
; This is GENERATED rather than hand-written on purpose. The first version of the silent check was a hand-written
; chain of nine ${If}s for nine popular currencies, so `/CURRENCY=UGX` -- a currency the app knows in full --
; aborted a legitimate install. Generating one branch per catalogue entry means the silent path and the wizard's
; dropdown can never disagree.
; ==========================================================================================
!macro ValidateCurrencyCode
  StrCpy $3 ""
  ${If} $0 == "NGN"
    StrCpy $2 "0"
    StrCpy $3 "NGN"
  ${EndIf}
  ${If} $0 == "USD"
    StrCpy $2 "1"
    StrCpy $3 "USD"
  ${EndIf}
  ${If} $0 == "EUR"
    StrCpy $2 "2"
    StrCpy $3 "EUR"
  ${EndIf}
  ${If} $0 == "GBP"
    StrCpy $2 "3"
    StrCpy $3 "GBP"
  ${EndIf}
  ${If} $0 == "GHS"
    StrCpy $2 "4"
    StrCpy $3 "GHS"
  ${EndIf}
  ${If} $0 == "KES"
    StrCpy $2 "5"
    StrCpy $3 "KES"
  ${EndIf}
  ${If} $0 == "ZAR"
    StrCpy $2 "6"
    StrCpy $3 "ZAR"
  ${EndIf}
  ${If} $0 == "XOF"
    StrCpy $2 "7"
    StrCpy $3 "XOF"
  ${EndIf}
  ${If} $0 == "XAF"
    StrCpy $2 "8"
    StrCpy $3 "XAF"
  ${EndIf}
  ${If} $0 == "UGX"
    StrCpy $2 "9"
    StrCpy $3 "UGX"
  ${EndIf}
  ${If} $0 == "TZS"
    StrCpy $2 "10"
    StrCpy $3 "TZS"
  ${EndIf}
  ${If} $0 == "RWF"
    StrCpy $2 "11"
    StrCpy $3 "RWF"
  ${EndIf}
  ${If} $0 == "ETB"
    StrCpy $2 "12"
    StrCpy $3 "ETB"
  ${EndIf}
  ${If} $0 == "EGP"
    StrCpy $2 "13"
    StrCpy $3 "EGP"
  ${EndIf}
  ${If} $0 == "MAD"
    StrCpy $2 "14"
    StrCpy $3 "MAD"
  ${EndIf}
  ${If} $0 == "TND"
    StrCpy $2 "15"
    StrCpy $3 "TND"
  ${EndIf}
  ${If} $0 == "DZD"
    StrCpy $2 "16"
    StrCpy $3 "DZD"
  ${EndIf}
  ${If} $0 == "ZMW"
    StrCpy $2 "17"
    StrCpy $3 "ZMW"
  ${EndIf}
  ${If} $0 == "MWK"
    StrCpy $2 "18"
    StrCpy $3 "MWK"
  ${EndIf}
  ${If} $0 == "BWP"
    StrCpy $2 "19"
    StrCpy $3 "BWP"
  ${EndIf}
  ${If} $0 == "NAD"
    StrCpy $2 "20"
    StrCpy $3 "NAD"
  ${EndIf}
  ${If} $0 == "MZN"
    StrCpy $2 "21"
    StrCpy $3 "MZN"
  ${EndIf}
  ${If} $0 == "AOA"
    StrCpy $2 "22"
    StrCpy $3 "AOA"
  ${EndIf}
  ${If} $0 == "GMD"
    StrCpy $2 "23"
    StrCpy $3 "GMD"
  ${EndIf}
  ${If} $0 == "SLE"
    StrCpy $2 "24"
    StrCpy $3 "SLE"
  ${EndIf}
  ${If} $0 == "LRD"
    StrCpy $2 "25"
    StrCpy $3 "LRD"
  ${EndIf}
  ${If} $0 == "CDF"
    StrCpy $2 "26"
    StrCpy $3 "CDF"
  ${EndIf}
  ${If} $0 == "SDG"
    StrCpy $2 "27"
    StrCpy $3 "SDG"
  ${EndIf}
