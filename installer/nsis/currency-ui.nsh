; Copies the chosen row's fields into the variables the installer uses. $R0 is the selected index; an empty
; selection falls back to the default currency rather than to whichever row happened to be first.
!macro SetCurrencyFromIndex
  ${If} $R0 == "0"
    StrCpy $CurrencyCodeOut "NGN"
    StrCpy $CurrencyNameOut "Nigerian naira"
    StrCpy $CurrencySymbolOut "₦"
    StrCpy $CurrencyDecimalsOut "2"
    StrCpy $CurrencyPositionOut "before"
    StrCpy $CurrencyThousandsOut ","
    StrCpy $CurrencyDecimalOut "."
  ${ElseIf} $R0 == "1"
    StrCpy $CurrencyCodeOut "USD"
    StrCpy $CurrencyNameOut "US dollar"
