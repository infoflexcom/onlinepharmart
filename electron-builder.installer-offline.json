{
  "extends": null,
  "appId": "com.infoflex.pharmart",
  "productName": "Infoflex",
  "npmRebuild": false,
  "asarUnpack": ["**/*.node"],
  "files": ["out/**/*", "package.json", "installer/nsis/generated.nsh", "installer/nsis/currency-ui.nsh"],
  "//": "The build profile is packed beside the app so first-run setup reads the same currency the installer compiled in. It is written by npm run installer:script, which both installer builds run first.",
  "extraResources": ["installer/nsis/build-profile.json"],
  "directories": { "buildResources": "build", "output": "dist/offline" },
  "win": {
    "icon": "build/icon.ico",
    "target": [{ "target": "nsis", "arch": ["x64"] }]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowElevation": true,
    "include": "installer/nsis/installer.nsi",
    "installerIcon": "build/icon.ico",
    "installerHeader": "build/installer-banner.bmp",
    "installerSidebar": "build/installer-sidebar.bmp",
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Infoflex",
    "artifactName": "Infoflex Setup Offline.${ext}",
    "defines": { "INFOPLEX_OFFLINE": "1" }
  }
}
